# Mainnet read-only launch transparency. Never put a private key in Vite env files.
VITE_MAINNET_RPC_ENDPOINT=https://api.mainnet-beta.solana.com
VITE_ALPHA_LAUNCH_STATUS=prelaunch

# Leave these empty until the launch-day values have been independently verified.
VITE_ALPHA_MAINNET_MINT=
VITE_REVENUE_WALLET=
VITE_ALPHA_PUMP_URL=

# Accumulate confirmed USDC revenue before creating a 50/20/20/10 distribution batch.
VITE_REVENUE_DISTRIBUTION_THRESHOLD_USDC=100

# Optional off-chain operations backend.
# Use only a browser-safe anon/publishable key. Never use service-role or sb_secret_ keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_OPERATIONS_PROJECT_REF=
VITE_OPERATIONS_WEB3_URL=

# Browser-safe Cloudflare Turnstile site key. Never put a Turnstile secret key,
# Supabase service-role key, or any other server credential in a VITE_* variable.
VITE_TURNSTILE_SITE_KEY=

# Keep disabled until the wallet-auth migration, RLS/rate-limit checks, Supabase
# Web3 Wallet provider, exact Redirect URL/page binding, Turnstile, and abuse
# controls are verified. VITE_OPERATIONS_WEB3_URL must be that exact HTTPS page.
VITE_OPERATIONS_INTAKE_MODE=disabled

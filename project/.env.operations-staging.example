# Copy to .env.operations-staging only on a trusted operator workstation.
# The real file is gitignored. Never prefix the service key with VITE_.

OPERATIONS_STAGING_PROJECT_REF=
OPERATIONS_STAGING_SUPABASE_URL=
OPERATIONS_STAGING_PUBLIC_KEY=
OPERATIONS_STAGING_SERVICE_ROLE_KEY=

# Exact HTTPS page already allowlisted in Supabase Auth Redirect URLs.
# Required only for the wallet-authenticated mutating E2E.
OPERATIONS_STAGING_WEB3_URL=

# Required only by the mutating E2E command:
# I_UNDERSTAND_THIS_CREATES_AND_DELETES_STAGING_TEST_DATA
CONFIRM_OPERATIONS_STAGING_E2E=

# Required only for an explicitly reviewed database intake-gate transition.
# Use a commit, runbook, decision, or change-ticket reference (10–200 chars).
OPERATIONS_STAGING_GATE_CHANGE_REFERENCE=

# Exact activation confirmation:
# I_UNDERSTAND_THIS_ENABLES_WALLET_AUTHENTICATED_STAGING_WRITES
CONFIRM_OPERATIONS_STAGING_GATE_ACTIVATION=

# Exact emergency-disable confirmation:
# I_UNDERSTAND_THIS_DISABLES_WALLET_AUTHENTICATED_STAGING_WRITES
CONFIRM_OPERATIONS_STAGING_GATE_DISABLE=

# Copy to .env.operations-staging only on a trusted operator workstation.
# The real file is gitignored. Never prefix the service key with VITE_.

OPERATIONS_STAGING_PROJECT_REF=
OPERATIONS_STAGING_SUPABASE_URL=
OPERATIONS_STAGING_PUBLIC_KEY=
OPERATIONS_STAGING_SERVICE_ROLE_KEY=

# Required only by the mutating E2E command:
# I_UNDERSTAND_THIS_CREATES_AND_DELETES_STAGING_TEST_DATA
CONFIRM_OPERATIONS_STAGING_E2E=

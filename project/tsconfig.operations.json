{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "vite/client"]
  },
  "include": [
    "scripts/operations-staging/**/*.ts",
    "tests/**/*.test.ts",
    "src/lib/operationsSupabase.ts",
    "src/features/operations/domain.ts"
  ]
}
